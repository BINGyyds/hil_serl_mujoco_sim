# udev rules for 3Dconnexion SpaceMouse devices.
# Allows non-root users to read HID input from SpaceMouse.
#
# Install:
#   sudo cp 99-spacemouse.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="256f", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="256f", MODE="0666"
