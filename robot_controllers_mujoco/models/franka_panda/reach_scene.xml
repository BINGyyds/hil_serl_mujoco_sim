<mujoco model="panda reach scene">
  <include file="panda_nohand_position.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <worldbody>
    <!-- Target marker (mocap body, kinematic, not simulated) -->
    <body name="target" mocap="true" pos="0.5 0.0 0.5">
      <geom type="sphere" size="0.02" rgba="1 0 0 0.8" contype="0" conaffinity="0" group="2"/>
      <geom type="sphere" size="0.04" rgba="1 0 0 0.15" contype="0" conaffinity="0" group="2"/>
      <!-- Orientation axes for target -->
      <site name="target_x" type="cylinder" size="0.005 0.04" rgba="1 0 0 0.6" pos="0.04 0 0" euler="0 1.5708 0"/>
      <site name="target_y" type="cylinder" size="0.005 0.04" rgba="0 1 0 0.6" pos="0 0.04 0" euler="1.5708 0 0"/>
      <site name="target_z" type="cylinder" size="0.005 0.04" rgba="0 0 1 0.6" pos="0 0 0.04"/>
      <site name="target_site" size="0.001"/>
    </body>

    <!-- Cameras -->
    <camera name="front" pos="1.5 0 0.8" xyaxes="0 1 0 -0.4 0 1" fovy="45"/>
    <camera name="side" pos="0 1.5 0.8" xyaxes="-1 0 0 0 -0.4 1" fovy="45"/>
    <camera name="top" pos="0.3 0 2.0" xyaxes="0 1 0 -1 0 0" fovy="60"/>
    <camera name="wrist" pos="0 0 0" mode="targetbodycom" target="link7" fovy="60"/>
  </worldbody>
</mujoco>
